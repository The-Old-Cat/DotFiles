# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

# --- Установка Age через scoop ---
function Install-Age {
    if (Get-Command age-keygen -ErrorAction SilentlyContinue) {
        Write-Host "age is already installed."
        return
    }

    Write-Host "Installing age via scoop..."

    if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
        Write-Warning "scoop is not installed. Please install it first: iwr -useb get.scoop.sh | iex"
        return
    }

    scoop install age | Out-Null
    Write-Host "age installed successfully."
}

# --- Основной блок ---
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Using scoop for package installation..."

    # Добавляем необходимые buckets (один раз)
    $buckets = (scoop bucket list 2>$null).Name

    if ($buckets -notcontains "extras") {
        Write-Host "Adding 'extras' bucket..."
        scoop bucket add extras | Out-Null
    }

    if ($buckets -notcontains "nerd-fonts") {
        Write-Host "Adding 'nerd-fonts' bucket..."
        scoop bucket add nerd-fonts | Out-Null
    }

    if ($buckets -notcontains "sysinternals") {
        Write-Host "Adding 'sysinternals' bucket..."
        scoop bucket add sysinternals | Out-Null
    }

    # Устанавливаем age (после добавления buckets)
    Install-Age

    $packages = @(
        # Основные инструменты
        "git", "gh", "fd", "ripgrep", "fzf", "restic",
        "windows-terminal", "alacritty", "uv", "advanced-ip-scanner",
        "pwsh", "vscode", "curl", "sudo", "grep", "aria2", "7zip",

        # CLI-улучшения
        "jq", "yq",
        "zoxide",
        "dust",
        "procs",
        "bat",
        "starship",

        # Сеть / утилиты
        "nmap",
        "curlie",
        "wget",
        "yt-dlp",
        "ffmpeg",

        # Безопасность / продуктивность
        "bitwarden-cli",
        "obsidian",
        "flow-launcher",

        # Разработка
        "nodejs-lts",
        "go",

        # Sysinternals
        "process-explorer",
        "autoruns",
        "tcpview",
        "handle",
        "du",
        "procmon",
        "psservice",
        "rammap",
        "sysmon"
    )

    foreach ($pkg in $packages) {
        Write-Host "Installing $pkg..."
        scoop install $pkg 2>&1 | Out-Null
    }

    # --- Регистрация VS Code в системе ---
    Write-Host "Registering VS Code in system..."
    $vscodePath = "$env:USERPROFILE\scoop\apps\vscode\current"

    if (Test-Path $vscodePath) {
        reg import "$vscodePath\install-context.reg" 2>&1 | Out-Null
        reg import "$vscodePath\install-associations.reg" 2>&1 | Out-Null
        reg import "$vscodePath\install-github-integration.reg" 2>&1 | Out-Null
        Write-Host "✓ VS Code registered"
    }
    else {
        Write-Warning "VS Code not found at $vscodePath"
    }

    # --- Шрифты Nerd Fonts ---
    Write-Host "Installing JetBrainsMono-NF..."
    scoop install JetBrainsMono-NF | Out-Null

    # Принудительная регистрация TTF/OTF шрифтов в реестре Windows Пользователя (HKCU)
    Write-Host "Registering JetBrainsMono-NF in HKCU registry..."
    $fontPath = "$env:USERPROFILE\scoop\apps\JetBrainsMono-NF\current"
    if (Test-Path $fontPath) {
        Get-ChildItem -Path $fontPath -Include "*.ttf", "*.otf" -Recurse | ForEach-Object {
            $fontName = $_.BaseName + " (TrueType)"
            New-ItemProperty -Path "HKCU:\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Fonts" -Name $fontName -Value $_.FullName -PropertyType String -Force | Out-Null
        }
        Write-Host "✓ Fonts registered successfully"
    }

    # --- PowerShell Profile + Starship ---
    Write-Host "Configuring PowerShell profile for Starship..."

    if (!(Test-Path -Path $PROFILE)) {
        New-Item -ItemType File -Path $PROFILE -Force | Out-Null
        Write-Host "Created PowerShell profile: $PROFILE"
    }

    $starshipBlock = @'
# Managed by chezmoi

# Starship Config Path
$env:STARSHIP_CONFIG = "$HOME\.config\starship\starship.toml"

# Starship prompt init
if (Get-Command starship -ErrorAction SilentlyContinue) {
    Invoke-Expression (&starship init powershell)
}
'@

    $profileContent = Get-Content -Path $PROFILE -Raw -ErrorAction SilentlyContinue

    if ($profileContent -notmatch "starship init powershell") {
        if ([string]::IsNullOrWhiteSpace($profileContent)) {
            Set-Content -Path $PROFILE -Value $starshipBlock -Encoding UTF8
        }
        else {
            Add-Content -Path $PROFILE -Value "`n$starshipBlock" -Encoding UTF8
        }
        Write-Host "✓ Starship init and custom config path added to PowerShell profile"
    }
    else {
        Write-Host "✓ Starship already configured in PowerShell profile"
    }

    # --- Проверка конфига Alacritty ---
    $alacrittyConfig = "$env:APPDATA\alacritty\alacritty.toml"
    if (Test-Path $alacrittyConfig) {
        Write-Host "✓ Alacritty config is present in AppData"
    }
    else {
        Write-Warning "Alacritty config not found in AppData. Run 'chezmoi apply' if needed."
    }

    Write-Host "All Windows packages installed via scoop."
}
else {
    Write-Warning "Scoop is not installed. Please run: iwr -useb get.scoop.sh | iex"
}

{{- end }}
