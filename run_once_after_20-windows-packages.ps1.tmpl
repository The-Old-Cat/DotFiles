# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

# --- Установка Age через scoop ---
function Install-Age {
    if (Get-Command age-keygen -ErrorAction SilentlyContinue) {
        Write-Host "age is already installed."
        return
    }

    Write-Host "Installing age via scoop..."

    # Проверяем, установлен ли scoop
    if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
        Write-Warning "scoop is not installed. Please install it first: iwr -useb get.scoop.sh | iex"
        return
    }

    # Добавляем бакет extras
    $buckets = (scoop bucket list 2>$null).Name
    if ($buckets -notcontains "extras") {
        Write-Host "Adding 'extras' bucket..."
        scoop bucket add extras | Out-Null
    }

    scoop install age | Out-Null
    Write-Host "age installed successfully."
}
Install-Age

# --- Функция для регистрации VS Code в системе ---
function Register-VSCode {
    $vscodePath = "$env:USERPROFILE\scoop\apps\vscode\current"

    # Проверяем, что VS Code установлен
    if (-not (Test-Path $vscodePath)) {
        Write-Host "VS Code not found at $vscodePath, skipping registration."
        return
    }

    Write-Host "Registering VS Code in system..."

    # Файлы .reg для импорта
    $regFiles = @(
        "install-context.reg",
        "install-associations.reg",
        "install-github-integration.reg"
    )

    $successCount = 0
    foreach ($regFile in $regFiles) {
        $regPath = Join-Path $vscodePath $regFile
        if (Test-Path $regPath) {
            Write-Host "Importing $regFile..."
            try {
                reg import $regPath
                $successCount++
            }
            catch {
                Write-Warning "Failed to import $regFile: $_"
            }
        }
        else {
            Write-Warning "$regFile not found at $regPath"
        }
    }

    if ($successCount -eq $regFiles.Count) {
        Write-Host "✅ VS Code successfully registered in system."
    }
    else {
        Write-Host "⚠️ Partially registered ($successCount of $($regFiles.Count) files imported)."
    }
}

# --- Установка остальных пакетов ---
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Using scoop for package installation..."
    $packages = @("git", "gh", "fd", "ripgrep", "fzf", "restic", "windows-terminal", "pwsh", "vscode")
    foreach ($pkg in $packages) {
        Write-Host "Installing $pkg..."
        scoop install $pkg 2>&1 | Out-Null
    }

    # --- Регистрация VS Code в системе (после установки) ---
    Register-VSCode

    # Шрифты Nerd Fonts
    $buckets = (scoop bucket list 2>$null).Name
    if ($buckets -notcontains "nerd-fonts") {
        Write-Host "Adding 'nerd-fonts' bucket..."
        scoop bucket add nerd-fonts | Out-Null
    }
    Write-Host "Installing Hasklig-NF..."
    scoop install Hasklig-NF | Out-Null

    Write-Host "All Windows packages installed via scoop."
}
else {
    Write-Warning "Scoop is not installed. Please run: iwr -useb get.scoop.sh | iex"
}

{{- end }}
