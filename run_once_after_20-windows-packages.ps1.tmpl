# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

# age: в scoop нет manifest — ставим из официального релиза
function Install-Age {
    if (Get-Command age-keygen -ErrorAction SilentlyContinue) { return }
    Write-Host "Installing age from GitHub releases..."
    $rel = Invoke-RestMethod "https://api.github.com/repos/FiloSottile/age/releases/latest"
    $url = ($rel.assets | Where-Object { $_.name -match "windows-amd64\.zip" } | Select-Object -First 1).browser_download_url
    Invoke-WebRequest $url -OutFile "$env:TEMP\age.zip"
    Expand-Archive "$env:TEMP\age.zip" -DestinationPath "$env:TEMP\age" -Force
    $bin = "$env:USERPROFILE\.local\bin"
    New-Item -ItemType Directory -Force $bin | Out-Null
    $exe = Get-ChildItem "$env:TEMP\age" -Recurse -Filter "age.exe" | Select-Object -First 1
    Copy-Item $exe.FullName, (Join-Path $exe.DirectoryName "age-keygen.exe") $bin -Force
    $u = [Environment]::GetEnvironmentVariable("PATH", "User")
    if ($u -notlike "*$bin*") { [Environment]::SetEnvironmentVariable("PATH", "$u;$bin", "User") }
    Remove-Item "$env:TEMP\age.zip", "$env:TEMP\age" -Recurse -Force
}
Install-Age

if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Using scoop..."
    $packages = @("git", "gh", "fd", "ripgrep", "fzf", "restic")
    foreach ($pkg in $packages) {
        Write-Host "Installing $pkg..."
        scoop install $pkg 2>&1 | Out-Null
    }

    $buckets = (scoop bucket list 2>$null).Name
    if (-not ($buckets -contains "nerd-fonts")) {
        scoop bucket add nerd-fonts | Out-Null
    }
    Write-Host "Installing Hasklig-NF..."
    scoop install Hasklig-NF | Out-Null
    Write-Host "Windows packages installed"
}
elseif (Get-Command winget -ErrorAction SilentlyContinue) {
    Write-Host "Using winget..."
    $packages = @(
        "Git.Git", "GitHub.cli", "sharkdp.fd",
        "BurntSushi.ripgrep.MSVC", "Junegunn.fzf", "NerdFonts.Hasklig"
    )
    foreach ($pkg in $packages) {
        Write-Host "Installing $pkg..."
        winget install --id $pkg --silent `
            --accept-source-agreements --accept-package-agreements `
            --source winget 2>&1 | Out-Null
    }
}
else {
    Write-Warning "Neither scoop nor winget found. Bootstrap: iwr -useb get.scoop.sh | iex"
}

{{- end }}
