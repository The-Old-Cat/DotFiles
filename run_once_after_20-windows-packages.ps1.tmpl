# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Continue"  # Не останавливаемся при ошибках

# --- Создание лога установки ---
$logFile = "$env:USERPROFILE\scoop\logs\scoop-install-log-$(Get-Date -Format 'yyyy-MM-dd-HH-mm-ss').txt"
Start-Transcript -Path $logFile -Append

Write-Host "========================================" -ForegroundColor Cyan
Write-Host "  WINDOWS PACKAGES INSTALLATION SCRIPT  " -ForegroundColor Cyan
Write-Host "========================================" -ForegroundColor Cyan
Write-Host "Started at: $(Get-Date)" -ForegroundColor Yellow
Write-Host "Log file: $logFile`n" -ForegroundColor Yellow

# --- Проверка архитектуры системы ---
if ([Environment]::Is64BitOperatingSystem) {
    Write-Host "✓ Running on 64-bit system" -ForegroundColor Green
} else {
    Write-Host "⚠️ Running on 32-bit system (limited package support)" -ForegroundColor Yellow
}

# --- Функция для добавления bucket с проверкой ---
function Add-Bucket {
    param($BucketName)

    $buckets = (scoop bucket list 2>$null).Name
    if ($buckets -notcontains $BucketName) {
        Write-Host "Adding '$BucketName' bucket..." -ForegroundColor Yellow
        try {
            scoop bucket add $BucketName 2>&1 | Out-Null
            if ($LASTEXITCODE -eq 0) {
                Write-Host "✓ '$BucketName' bucket added" -ForegroundColor Green
            } else {
                Write-Warning "⚠️ Failed to add '$BucketName' bucket"
            }
        } catch {
            Write-Warning "⚠️ Error adding '$BucketName' bucket: $_"
        }
    } else {
        Write-Host "✓ '$BucketName' bucket already exists" -ForegroundColor Green
    }
}

# --- Функция для установки пакетов с расширенной проверкой ---
function Install-Package {
    param($Package)

    Write-Host "Installing $Package..." -ForegroundColor Cyan

    # Проверяем, установлен ли уже пакет
    $installed = scoop list 2>$null | ForEach-Object { ($_ -split '\s+')[0] } | Where-Object { $_ -eq $Package }
    if ($installed) {
        Write-Host "✓ $Package already installed" -ForegroundColor Green
        return
    }

    try {
        $result = scoop install $Package 2>&1
        if ($LASTEXITCODE -eq 0) {
            Write-Host "✓ $Package installed successfully" -ForegroundColor Green
        } else {
            Write-Warning "⚠️ Failed to install $Package"
            if ($result -match "already installed") {
                Write-Host "   Package already installed (detected)" -ForegroundColor Gray
            } else {
                Write-Host "   Error: $($result -join '; ')" -ForegroundColor Gray
            }
        }
    } catch {
        Write-Warning "⚠️ Error installing $Package: $_"
    }
}

# --- Функция для установки группы пакетов с прогрессом ---
function Install-PackageGroup {
    param(
        $GroupName,
        $Packages
    )

    Write-Host "`n📦 Installing $GroupName packages..." -ForegroundColor Magenta
    Write-Host ("-" * 50) -ForegroundColor Gray

    $total = $Packages.Count
    $current = 0

    foreach ($pkg in $Packages) {
        $current++
        Write-Progress -Activity "Installing $GroupName packages" -Status "Package $current of $total: $pkg" -PercentComplete (($current / $total) * 100)
        Install-Package $pkg
    }

    Write-Progress -Activity "Installing $GroupName packages" -Completed
}

# --- Основной блок ---
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "`n✅ Scoop found. Starting package installation..." -ForegroundColor Green

    # --- Обновление Scoop ---
    Write-Host "`n🔄 Updating Scoop..." -ForegroundColor Cyan
    scoop update 2>&1 | Out-Null
    Write-Host "✓ Scoop updated" -ForegroundColor Green

    # --- Добавление необходимых buckets ---
    Write-Host "`n📦 Adding buckets..." -ForegroundColor Cyan
    Add-Bucket "extras"
    Add-Bucket "nerd-fonts"
    Add-Bucket "sysinternals"

    # --- Очистка кеша (опционально) ---
    Write-Host "`n🧹 Cleaning Scoop cache..." -ForegroundColor Cyan
    scoop cache rm --all 2>&1 | Out-Null
    Write-Host "✓ Cache cleaned" -ForegroundColor Green

    # --- КАТЕГОРИИ ПАКЕТОВ ---
    $packageGroups = @{
        "Основные инструменты" = @(
            "git",
            "gh",
            "fd",
            "ripgrep",
            "fzf",
            "restic",
            "windows-terminal",
            "wezterm",
            "uv",
            "advanced-ip-scanner",
            "unlocker",
            "pwsh",
            "vscode",
            "curl",
            "sudo",
            "grep",
            "aria2",
            "7zip"
        )

        "CLI-улучшения" = @(
            "jq",
            "yq",
            "zoxide",
            "dust",
            "procs",
            "bat",
            "starship"
        )

        "Сеть и утилиты" = @(
            "nmap",
            "curlie",
            "wget",
            "yt-dlp",
            "ffmpeg"
        )

        "Безопасность и продуктивность" = @(
            "bitwarden-cli",
            "age ",
            "obsidian",
            "flow-launcher"
        )

        "Разработка" = @(
            "nodejs-lts",
            "go"
        )

        "Sysinternals" = @(
            "process-explorer",
            "autoruns",
            "tcpview",
            "handle",
            "du",
            "procmon",
            "psservice",
            "rammap",
            "sysmon"
        )
    }

    # --- Установка всех групп пакетов ---
    foreach ($group in $packageGroups.Keys) {
        Install-PackageGroup -GroupName $group -Packages $packageGroups[$group]
    }

    # --- Установка шрифтов Nerd Fonts ---
    Write-Host "`n🔤 Installing Nerd Fonts..." -ForegroundColor Magenta
    Write-Host ("-" * 50) -ForegroundColor Gray

    $fonts = @(
        "Cascadia-Code",
        "JetBrainsMono-NF",
        "JetBrainsMono-NF-Mono"
    )

    foreach ($font in $fonts) {
        Install-Package $font
    }

    # --- Регистрация VS Code в системе ---
    Write-Host "`n🔧 Registering VS Code in system..." -ForegroundColor Cyan
    Write-Host ("-" * 50) -ForegroundColor Gray

    $vscodePath = "$env:USERPROFILE\scoop\apps\vscode\current"

    if (Test-Path $vscodePath) {
        $regFiles = @(
            "install-context.reg",
            "install-associations.reg",
            "install-github-integration.reg"
        )

        $successCount = 0
        foreach ($regFile in $regFiles) {
            $regPath = Join-Path $vscodePath $regFile
            if (Test-Path $regPath) {
                try {
                    $result = reg import $regPath 2>&1
                    if ($LASTEXITCODE -eq 0) {
                        Write-Host "✓ Imported $regFile" -ForegroundColor Green
                        $successCount++
                    } else {
                        Write-Warning "⚠️ Failed to import $regFile (exit code: $LASTEXITCODE)"
                        Write-Host "   Error: $result" -ForegroundColor Gray
                    }
                } catch {
                    Write-Warning "⚠️ Error importing $regFile: $_"
                }
            } else {
                Write-Warning "⚠️ $regFile not found at $regPath"
            }
        }

        if ($successCount -eq $regFiles.Count) {
            Write-Host "✅ All VS Code registrations completed successfully" -ForegroundColor Green
        } else {
            Write-Host "⚠️ Some VS Code registrations failed ($successCount/$($regFiles.Count))" -ForegroundColor Yellow
        }
    } else {
        Write-Warning "⚠️ VS Code not found at $vscodePath"
    }

    # --- Экспорт списка установленных пакетов ---
    Write-Host "`n📝 Exporting installed packages list..." -ForegroundColor Cyan
    Write-Host ("-" * 50) -ForegroundColor Gray

    $exportPath = "$env:USERPROFILE\scoop\logs\scoop-packages-$(Get-Date -Format 'yyyy-MM-dd').txt"
    try {
        scoop list > $exportPath
        Write-Host "✓ Exported to: $exportPath" -ForegroundColor Green
    } catch {
        Write-Warning "⚠️ Failed to export packages list: $_"
    }

    # --- Финальная статистика ---
    Write-Host "`n📊 Installation Summary:" -ForegroundColor Cyan
    Write-Host ("=" * 50) -ForegroundColor Cyan

    $totalPackages = 0
    foreach ($group in $packageGroups.Keys) {
        $totalPackages += $packageGroups[$group].Count
    }
    $totalPackages += $fonts.Count

    Write-Host "Total packages attempted: $totalPackages" -ForegroundColor Yellow
    Write-Host "Total groups: $($packageGroups.Keys.Count)" -ForegroundColor Yellow
    Write-Host "Fonts installed: $($fonts.Count)" -ForegroundColor Yellow
    Write-Host "Log file: $logFile" -ForegroundColor Yellow

    Write-Host "`n✅ All Windows packages installation completed!" -ForegroundColor Green
    Write-Host "Completion time: $(Get-Date)" -ForegroundColor Yellow

} else {
    Write-Warning "⚠️ Scoop is not installed!"
    Write-Host "Please run the following command to install Scoop:" -ForegroundColor Cyan
    Write-Host "iwr -useb get.scoop.sh | iex" -ForegroundColor Yellow
    Write-Host "`nAfter installing Scoop, run this script again." -ForegroundColor Cyan
}

# --- Остановка логирования ---
Stop-Transcript

Write-Host "`n📄 Full installation log saved to: $logFile" -ForegroundColor Green

{{- end }}
