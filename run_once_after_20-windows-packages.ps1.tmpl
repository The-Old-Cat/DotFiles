# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

# --- Установка Age через scoop ---
function Install-Age {
    if (Get-Command age-keygen -ErrorAction SilentlyContinue) {
        Write-Host "age is already installed."
        return
    }

    Write-Host "Installing age via scoop..."

    if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
        Write-Warning "scoop is not installed. Please install it first: iwr -useb get.scoop.sh | iex"
        return
    }

    $buckets = (scoop bucket list 2>$null).Name
    if ($buckets -notcontains "extras") {
        Write-Host "Adding 'extras' bucket..."
        scoop bucket add extras | Out-Null
    }

    scoop install age | Out-Null
    Write-Host "age installed successfully."
}
Install-Age

# --- Функция для установки Alacritty конфига в AppData ---
function Set-AlacrittyConfig {
    $sourcePath = "$env:USERPROFILE\.config\alacritty\alacritty.windows.toml"
    $targetPath = "$env:APPDATA\alacritty\alacritty.toml"
    $configDir = "$env:APPDATA\alacritty"

    # Создаем папку в AppData, если её нет
    if (-not (Test-Path $configDir)) {
        New-Item -ItemType Directory -Path $configDir -Force | Out-Null
        Write-Host "Created Alacritty config directory in AppData"
    }

    # Проверяем, существует ли файл-источник
    if (-not (Test-Path $sourcePath)) {
        Write-Warning "alacritty.windows.toml not found at $sourcePath"
        Write-Host "Please ensure the config file exists in your chezmoi source"
        return
    }

    # Копируем конфиг в AppData (с перезаписью)
    try {
        Copy-Item -Path $sourcePath -Destination $targetPath -Force
        Write-Host "✓ Alacritty config updated in AppData"
    }
    catch {
        Write-Warning "Failed to copy config: $_"
    }
}

# --- Функция для создания симлинка на Alacritty конфиг (для совместимости) ---
function Set-AlacrittySymlink {
    $configPath = "$env:USERPROFILE\.config\alacritty"
    $targetPath = "$configPath\alacritty.windows.toml"
    $linkPath = "$configPath\alacritty.toml"

    if (-not (Test-Path $configPath)) {
        New-Item -ItemType Directory -Path $configPath -Force | Out-Null
        Write-Host "Created Alacritty config directory"
    }

    if (-not (Test-Path $targetPath)) {
        Write-Warning "alacritty.windows.toml not found at $targetPath"
        return
    }

    if (Test-Path $linkPath) {
        Remove-Item -Path $linkPath -Force
    }

    try {
        New-Item -ItemType SymbolicLink -Path $linkPath -Target $targetPath -Force | Out-Null
        Write-Host "✓ Symlink created for Windows Alacritty config"
    }
    catch {
        Write-Warning "Failed to create symlink, copying instead..."
        Copy-Item -Path $targetPath -Destination $linkPath -Force
        Write-Host "✓ Config copied"
    }
}

# --- Установка остальных пакетов ---
if (Get-Command scoop -ErrorAction SilentlyContinue) {
    Write-Host "Using scoop for package installation..."
    $packages = @(
        "git", "gh", "fd", "ripgrep", "fzf", "restic",
        "windows-terminal", "alacritty", "uv", "advanced-ip-scanner",
        "pwsh", "vscode", "curl", "sudo", "grep", "aria2", "7zip"
    )
    foreach ($pkg in $packages) {
        Write-Host "Installing $pkg..."
        scoop install $pkg 2>&1 | Out-Null
    }

    # --- Регистрация VS Code в системе ---
    Write-Host "Registering VS Code in system..."
    $userProfile = $env:USERNAME
    $vscodePath = "C:\Users\$userProfile\scoop\apps\vscode\current"

    if (Test-Path $vscodePath) {
        reg import "$vscodePath\install-context.reg" 2>&1 | Out-Null
        reg import "$vscodePath\install-associations.reg" 2>&1 | Out-Null
        reg import "$vscodePath\install-github-integration.reg" 2>&1 | Out-Null
        Write-Host "✓ VS Code registered"
    }
    else {
        Write-Warning "VS Code not found at $vscodePath"
    }

    # Шрифты Nerd Fonts
    $buckets = (scoop bucket list 2>$null).Name
    if ($buckets -notcontains "nerd-fonts") {
        Write-Host "Adding 'nerd-fonts' bucket..."
        scoop bucket add nerd-fonts | Out-Null
    }
    Write-Host "Installing Hasklig-NF..."
    scoop install Hasklig-NF | Out-Null

    # --- Настройка Alacritty ---
    Set-AlacrittySymlink   # Для совместимости
    Set-AlacrittyConfig    # Копирует в AppData (перезаписывает)

    Write-Host "All Windows packages installed via scoop."
}
else {
    Write-Warning "Scoop is not installed. Please run: iwr -useb get.scoop.sh | iex"
}

{{- end }}
