# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

# Проверяем, установлен ли scoop
if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Warning "scoop is not installed. Please install it first: iwr -useb get.scoop.sh | iex"
    return
}

# --- Основные инструменты ---
Write-Host "Installing core tools via scoop..."
$corePackages = @(
    "git", "gh", "fd", "ripgrep", "fzf", "restic",
    "windows-terminal", "wezterm", "uv", "pwsh", "vscode",
    "curl", "sudo", "grep", "aria2", "7zip"
)
foreach ($pkg in $corePackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- CLI улучшения ---
Write-Host "Installing CLI improvements..."
$cliPackages = @("jq", "yq", "zoxide", "dust", "procs", "bat", "starship", "lsd")
foreach ($pkg in $cliPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Сеть и утилиты ---
Write-Host "Installing network utilities..."
$networkPackages = @("nmap", "curlie", "wget", "yt-dlp", "ffmpeg")
foreach ($pkg in $networkPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Безопасность и продуктивность ---
Write-Host "Installing security and productivity tools..."
$prodPackages = @("bitwarden-cli", "obsidian", "flow-launcher")
foreach ($pkg in $prodPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Разработка ---
Write-Host "Installing development tools..."
$devPackages = @("nodejs-lts", "go")
foreach ($pkg in $devPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Sysinternals ---
Write-Host "Installing Sysinternals tools..."
$sysPackages = @(
    "process-explorer", "autoruns", "tcpview",
    "handle", "du", "procmon", "psservice",
    "rammap", "sysmon"
)
foreach ($pkg in $sysPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Nerd Fonts ---
Write-Host "Adding nerd-fonts bucket..."
$buckets = (scoop bucket list 2>$null).Name
if ($buckets -notcontains "nerd-fonts") {
    scoop bucket add nerd-fonts | Out-Null
}
Write-Host "Installing Nerd Fonts..."
$fontPackages = @("Cascadia-Code", "JetBrainsMono-NF", "JetBrainsMono-NF-Mono")
foreach ($pkg in $fontPackages) {
    Write-Host "Installing $pkg..."
    scoop install $pkg 2>&1 | Out-Null
}

# --- Автоматическая настройка VS Code ---
Write-Host "Configuring VS Code..."
code --install-extension ms-vscode.powershell 2>&1 | Out-Null
code --install-extension batisteo.vscode-helix 2>&1 | Out-Null
code --install-extension eamodio.gitlens 2>&1 | Out-Null

Write-Host "All Windows packages installed successfully."
{{- end }}
