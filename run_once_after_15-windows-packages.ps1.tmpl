# run_once_after_20-windows-packages.ps1.tmpl — Windows only
{{- if eq .chezmoi.os "windows" }}

$ErrorActionPreference = "Stop"

if (-not (Get-Command scoop -ErrorAction SilentlyContinue)) {
    Write-Warning "scoop is not installed. Please install it first: iwr -useb get.scoop.sh | iex"
    return
}

# --- 1. Подключение бакетов ---
Write-Host "Ensuring required Scoop buckets are added..."
$buckets = (scoop bucket list 2>$null).Name
$requiredBuckets = @("extras", "nerd-fonts", "nonportable")

foreach ($bucket in $requiredBuckets) {
    if ($buckets -notcontains $bucket) {
        Write-Host "Adding bucket: $bucket"
        scoop bucket add $bucket
    }
}

# --- 2. Формирование единого списка пакетов ---
Write-Host "Installing packages via Scoop..."

$packages = @(
    # Core & Tools
    "git", "gh", "fd", "ripgrep", "fzf", "restic", "sumatrapdf",
    "windows-terminal", "wezterm", "uv", "pwsh", "vscode", "pgadmin4",
    "curl", "sudo", "grep", "aria2", "7zip", "inkscape",

    # CLI improvements
    "jq", "yq", "zoxide", "dust", "procs", "bat", "starship", "eza",

    # Network & Utilities
    "nmap", "curlie", "wget", "yt-dlp", "ffmpeg", "winmtr",

    # Security & Productivity
    "bitwarden-cli", "obsidian", "flow-launcher",

    # Development
    "nodejs-lts", "go", "hugo-extended",

    # Sysinternals
    "process-explorer", "autoruns", "tcpview",
    "handle", "du", "procmon", "psservice",
    "rammap", "sysmon",

    # Nerd Fonts
    "Cascadia-Code", "JetBrainsMono-NF", "JetBrainsMono-NF-Mono"
)

# Пакетная установка одной командой (флаг --skip пропускает уже установленные)
scoop install @packages --skip

# --- 3. Автоматическая настройка VS Code ---
if (Get-Command code -ErrorAction SilentlyContinue) {
    Write-Host "Configuring VS Code extensions..."
    $extensions = @(
        "ms-vscode.powershell",
        "batisteo.vscode-helix",
        "eamodio.gitlens"
    )
    foreach ($ext in $extensions) {
        code --install-extension $ext --force
    }
} else {
    Write-Warning "VS Code (code) command not found in current PATH. Skipping extensions installation."
}

Write-Host "✓ All Windows packages processed successfully."
{{- end }}
