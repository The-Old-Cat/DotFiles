# run_after_30-windows-alacritty-sync.ps1.tmpl — синхронизация на КАЖДЫЙ apply
# Alacritty на Windows читает %APPDATA%\alacritty\alacritty.toml, а не ~/.config
{{- if eq .chezmoi.os "windows" }}
$src = "$env:USERPROFILE\.config\alacritty\alacritty.toml"
$dstDir = "$env:APPDATA\alacritty"
if (Test-Path $src) {
    New-Item -ItemType Directory -Force $dstDir | Out-Null
    Copy-Item $src "$dstDir\alacritty.toml" -Force
}
{{- end }}
