#!/usr/bin/env bash
# run_once_after_10-base-packages.sh.tmpl
# Условная установка пакетов и шрифтов: Linux only (Windows — отдельный .ps1.tmpl)
set -euo pipefail

{{- if eq .chezmoi.os "linux" }}

echo "OS: Linux | Hostname: {{ .chezmoi.hostname }}"

# Определяем, запущен ли скрипт в WSL
IS_WSL=false
if grep -qi microsoft /proc/version 2>/dev/null; then
    IS_WSL=true
    echo "Running in WSL environment"
else
    echo "Running in native Linux environment"
fi

# --- Ubuntu/Debian: базовые пакеты ---
if grep -qEi "(ubuntu|debian)" /etc/os-release 2>/dev/null; then

    # GitHub CLI: apt-репозиторий (только если gh ещё нет)
    if ! command -v gh >/dev/null 2>&1; then
        echo "Setting up GitHub CLI repository..."
        curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
            | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
        sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
            | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    fi

    echo "Installing base packages..."
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends \
        git curl wget htop jq age restic gh unzip tmux fontconfig

    # --- Установка терминала (только если НЕ WSL) ---
    if [ "$IS_WSL" = false ]; then
        echo "Installing terminal emulator for native Linux..."
        sudo apt-get install -y --no-install-recommends alacritty
        # Альтернатива: kitty
        # sudo apt-get install -y --no-install-recommends kitty
    else
        echo "Skipping terminal installation (running in WSL, terminal is on Windows)"
    fi

    # --- Установка uv (современный менеджер для Python) ---
    if ! command -v uv >/dev/null 2>&1; then
        echo "Installing uv (Python package manager)..."
        curl -LsSf https://astral.sh/uv/install.sh | sh

        # Добавляем ~/.cargo/bin в PATH для текущей сессии
        export PATH="$HOME/.cargo/bin:$PATH"

        # Добавляем ~/.cargo/bin в PATH навсегда (в .bashrc)
        if ! grep -q 'export PATH="$HOME/.cargo/bin:$PATH"' ~/.bashrc 2>/dev/null; then
            echo 'export PATH="$HOME/.cargo/bin:$PATH"' >> ~/.bashrc
            echo "✓ Added ~/.cargo/bin to PATH in .bashrc"
        fi

        if command -v uv >/dev/null 2>&1; then
            echo "✓ uv installed successfully"
            uv --version
        else
            echo "⚠️ uv installed but not in PATH. Please restart your terminal or run: source ~/.bashrc"
        fi
    else
        echo "uv is already installed"
        uv --version
    fi

    # --- Установка Python через uv (опционально) ---
    if command -v uv >/dev/null 2>&1; then
        echo "Pre-installing Python 3.12 via uv..."
        uv python install 3.12 2>/dev/null || echo "Python 3.12 already installed or uv not ready"
    fi

    {{- if eq .chezmoi.hostname "ADM00-01IT" }}
    # WSL-хост: Docker
    echo "Installing Docker for WSL..."
    sudo apt-get install -y --no-install-recommends \
        docker.io docker-compose-v2
    {{- end }}

    {{- if contains "proxmox" (lower .chezmoi.hostname) }}
    # Proxmox-хосты: утилиты управления
    echo "Installing Proxmox tools..."
    sudo apt-get install -y --no-install-recommends \
        pve-manager-tools
    {{- end }}

    # Шрифты: CascadiaCode-NF-Mono (официальный релиз nerd-fonts)
    # Устанавливаем только если НЕ WSL (в WSL шрифты обычно ставятся на Windows)
    if [ "$IS_WSL" = false ]; then
        if ! fc-list | grep -qi "hasklug"; then
            echo "Installing CascadiaCode-NF-Mono..."
            mkdir -p ~/.local/share/fonts/hasklig
            curl -fLo /tmp/Hasklig.zip \
                https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hasklig.zip
            unzip -qo /tmp/Hasklig.zip -d ~/.local/share/fonts/hasklig
            rm -f /tmp/Hasklig.zip
            fc-cache -f ~/.local/share/fonts >/dev/null
            echo "✓ CascadiaCode-NF-Mono installed"
        fi
    else
        echo "Skipping font installation (running in WSL, fonts are managed on Windows)"
    fi

    # --- Создание симлинка на правильный конфиг Alacritty (только если НЕ WSL) ---
    if [ "$IS_WSL" = false ]; then
        if [ -f ~/.config/alacritty/alacritty.linux.yml ]; then
            ln -sf ~/.config/alacritty/alacritty.linux.toml ~/.config/alacritty/alacritty.toml
            echo "✓ Symlink created for Linux Alacritty config"
        else
            echo "⚠️ alacritty.linux.yml not found, skipping symlink"
        fi
    else
        echo "Skipping Alacritty symlink (running in WSL, config is managed on Windows)"
    fi

    echo "✓ Linux run-once completed"

else
    echo "ERROR: Unsupported Linux distro" >&2
    exit 1
fi

{{- else }}

echo "Skipped: script is Linux-only, current OS is {{ .chezmoi.os }}"

{{- end }}
