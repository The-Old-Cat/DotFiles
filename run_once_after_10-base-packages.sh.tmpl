#!/usr/bin/env bash
# run_once_after_10-base-packages.sh.tmpl
# Условная установка пакетов и шрифтов: Linux (Ubuntu/Debian) / Windows (winget→scoop→manual)
set -euo pipefail

{{- if eq .chezmoi.os "linux" }}

echo "OS: Linux | Hostname: {{ .chezmoi.hostname }}"

# --- Ubuntu/Debian: базовые пакеты ---
if grep -qEi "(ubuntu|debian)" /etc/os-release 2>/dev/null; then

    # GitHub CLI: apt-репозиторий (только если gh ещё нет)
    if ! command -v gh >/dev/null 2>&1; then
        echo "Setting up GitHub CLI repository..."
        curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
            | sudo dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg
        sudo chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg
        echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
            | sudo tee /etc/apt/sources.list.d/github-cli.list > /dev/null
    fi

    echo "Installing base packages..."
    sudo apt-get update
    sudo apt-get install -y --no-install-recommends \
        git curl wget htop jq age restic gh unzip fontconfig

    {{- if eq .chezmoi.hostname "ADM00-01IT" }}
    # WSL-хост: Docker
    echo "Installing Docker for WSL..."
    sudo apt-get install -y --no-install-recommends \
        docker.io docker-compose-v2
    {{- end }}

    {{- if contains "proxmox" (lower .chezmoi.hostname) }}
    # Proxmox-хосты: утилиты управления
    echo "Installing Proxmox tools..."
    sudo apt-get install -y --no-install-recommends \
        pve-manager-tools
    {{- end }}

    # Шрифты: Hasklug Nerd Font (официальный релиз nerd-fonts)
    if ! fc-list | grep -qi "hasklug"; then
        echo "Installing Hasklug Nerd Font..."
        mkdir -p ~/.local/share/fonts/hasklig
        curl -fLo /tmp/Hasklig.zip \
            https://github.com/ryanoasis/nerd-fonts/releases/latest/download/Hasklig.zip
        unzip -q /tmp/Hasklig.zip -d ~/.local/share/fonts/hasklig
        rm -f /tmp/Hasklig.zip
        fc-cache -f ~/.local/share/fonts >/dev/null
        echo "✓ Hasklug Nerd Font installed"
    fi

else
    echo "ERROR: Unsupported Linux distro" >&2
    exit 1
fi

{{- else if eq .chezmoi.os "windows" }}

echo "OS: Windows | Hostname: {{ .chezmoi.hostname }}"

# --- Windows: каскад winget → scoop → manual ---
if command -v winget >/dev/null 2>&1; then
    echo "Using winget..."
    PACKAGES=(
        "Git.Git"
        "GitHub.cli"
        "sharkdp.fd"
        "BurntSushi.ripgrep.MSVC"
        "Junegunn.fzf"
        "NerdFonts.Hasklig"
    )
    for pkg in "${PACKAGES[@]}"; do
        echo "Installing $pkg..."
        winget install --id "$pkg" --silent \
            --accept-source-agreements --accept-package-agreements \
            || echo "WARN: failed to install $pkg"
    done

elif command -v scoop >/dev/null 2>&1; then
    echo "Using scoop..."
    PACKAGES=(git gh fd ripgrep fzf)
    for pkg in "${PACKAGES[@]}"; do
        echo "Installing $pkg..."
        scoop install "$pkg" || echo "WARN: failed to install $pkg"
    done

    # Шрифты через scoop nerd-fonts bucket
    echo "Installing Hasklug Nerd Font via scoop..."
    scoop bucket add nerd-fonts 2>/dev/null || true
    scoop install Hasklig-NF || echo "WARN: Hasklig-NF not installed via scoop"

else
    echo "WARN: Neither winget nor scoop found."
    echo ""
    echo "To bootstrap scoop (PowerShell, можно PS7):"
    echo "  Set-ExecutionPolicy -Scope CurrentUser RemoteSigned -Force"
    echo "  iwr -useb get.scoop.sh | iex"
    echo ""
    echo "Then re-run: chezmoi apply"
    echo ""
    echo "Or install manually:"
    echo "  - Git:        https://git-scm.com/download/win"
    echo "  - GitHub CLI: https://cli.github.com/"
    echo "  - Hasklug NF: fonts.ps1 or папка Hasklig на Яндекс.Диске"
fi

{{- else }}

echo "ERROR: Unsupported OS: {{ .chezmoi.os }}" >&2
exit 1

{{- end }}

echo "✓ Run-once script completed"
