# ============================================
README.md
docs/**
.chezmoi.toml.tmpl
.git/
.gitignore
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ============================================
# Сгенерированные файлы (всегда)
# ============================================
*.sh
*.ps1


# ============================================
# Условное игнорирование для Windows
# ============================================
{{- if eq .chezmoi.os "windows" }}
# Игнорируем все .sh.tmpl файлы
*.sh.tmpl
*.bash.tmpl
*.zsh.tmpl

# Но конкретно этот файл НЕ игнорируем
!run_once_after_20-windows-packages.ps1.tmpl

# Игнорируем Linux-конфиги
tmux/
helix/
.config/helix/
.config/tmux/
.config/nvim/
dot_bash*
dot_profile*
.profile
.bash*
.zsh*
.zprofile
.local/
.config/**/linux-only/

# Игнорируем Linux-скрипт
run_once_after_10-base-packages.sh.tmpl
{{- end }}

# ============================================
# Условное игнорирование для Linux
# ============================================
{{- if eq .chezmoi.os "linux" }}
# Игнорируем все .ps1.tmpl файлы
*.ps1.tmpl

# Но конкретно этот файл НЕ игнорируем
!run_once_after_10-base-packages.sh.tmpl

# Игнорируем Windows-конфиги
AppData/
Documents/
pwsh/
PowerShell/
.config/WindowsTerminal/
.config/PowerShell/

# Игнорируем Windows-скрипт
run_once_after_20-windows-packages.ps1.tmpl
{{- end }}
