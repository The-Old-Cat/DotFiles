# ~/.bashrc - Universal Chezmoi Config
# dot_bashrc
# === Защита от неинтерактивных сессий ===
case $- in
    *i*) ;;
      *) return;;
esac

# === Автопереход в HOME при старте WSL из директорий Windows ===
if [[ "$PWD" == "/mnt/c/Users/"* ]]; then
    cd ~
fi

# === История ===
export HISTCONTROL=ignoreboth:erasedups
export HISTSIZE=50000
export HISTFILESIZE=100000
shopt -s histappend

# === True Color Palette ===
C_RESET='\033[0m'
C_CYAN='\033[38;2;139;233;253m'

# === Функции ===
get_local_ip() {
    hostname -I 2>/dev/null | awk '{print $1}' || ip route get 1 2>/dev/null | awk '{print $7}' || echo "n/a"
}

cached_external_ip() {
    local cache_file="$HOME/.cache/external_ip"
    mkdir -p "$HOME/.cache"

    local is_fresh=0
    if [ -f "$cache_file" ]; then
        if [ -n "$(find "$cache_file" -mmin -5 2>/dev/null)" ]; then
            is_fresh=1
        fi
    fi

    if [ "$is_fresh" -eq 0 ]; then
        (curl -s --connect-timeout 1 --max-time 2 https://ifconfig.me/ip > "$cache_file" 2>/dev/null &)
    fi

    if [ -s "$cache_file" ]; then
        cat "$cache_file"
    else
        echo "offline"
    fi
}

# === Баннер при входе ===
print_banner() {
    local user=$USER
    local ext_ip=$(cached_external_ip)
    local loc_ip=$(get_local_ip)

    echo -e ""
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e "   💻 Приветствую тебя, ${user},"
    echo -e "      на борту $(hostname)!"
    echo -e "   🌐 Внешний IP: ${ext_ip}"
    echo -e "   🏠 Локальный IP: ${loc_ip}"
    echo -e "${C_CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${C_RESET}"
    echo -e ""
}

# Запуск баннера только в интерактивной сессии и не в tmux/zellij
if [[ $- == *i* ]] && [ -z "$TMUX" ] && [ -z "$ZELLIJ" ]; then
    print_banner
fi

# === Инициализация Starship ===
export STARSHIP_CONFIG="$HOME/.config/starship/starship.toml"
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
elif command -v starship.exe >/dev/null 2>&1; then
    eval "$(starship.exe init bash)"
fi

# === Алиасы ===
# === Навигация и списки (eza вместо ls) ===
if command -v eza >/dev/null 2>&1 || command -v eza.exe >/dev/null 2>&1; then
    alias ls='eza --icons --group-directories-first'
    alias ll='eza -l --icons --group-directories-first'
    alias la='eza -la --icons --group-directories-first'
    alias lt='eza --tree --level=2 --icons'
else
    alias ls='ls --color=auto'
    alias ll='ls -alFh --color=auto'
    alias la='ls -A --color=auto'
fi

# Переход по директориям
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'

# === Защита и безопасность ===
alias cp='cp -i'
alias mv='mv -i'
alias rm='rm -i'

# === Системный мониторинг ===
alias df='df -h'
alias du='du -h --max-depth=1'
alias free='free -h'
alias grep='grep --color=auto'

# === Сеть и диагностика ===
# Фолбэк для mtr: mtr-tiny (Linux) -> mtr (Linux) -> winmtr.exe (Git Bash / Windows)
if command -v mtr-tiny >/dev/null 2>&1; then
    alias mtr='mtr-tiny'
elif command -v winmtr.exe >/dev/null 2>&1; then
    alias mtr='winmtr.exe'
fi

alias myip='curl -s --max-time 2 https://ifconfig.me/ip && echo ""'
alias ports='ss -tulpn 2>/dev/null || netstat -tulanp'

# === Chezmoi & Git ===
alias cz='chezmoi'
alias cza='chezmoi apply'
alias cze='chezmoi edit'
alias czs='chezmoi status'

alias g='git'
alias gs='git status'
alias gl='git log --oneline --graph --decorate'

# === Переменные окружения ===
export PATH="$HOME/.local/bin:$PATH"
export TERM=xterm-256color
export COLORTERM=truecolor

# Текстовый редактор по умолчанию
if command -v micro >/dev/null 2>&1 || command -v micro.exe >/dev/null 2>&1; then
    export EDITOR=micro
    export VISUAL=micro
else
    export EDITOR=hx
    export VISUAL=hx
fi
