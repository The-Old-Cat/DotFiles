#!/usr/bin/env bash
set -euo pipefail

{{- if eq .chezmoi.os "linux" }}
if ! fc-list : family 2>/dev/null | grep -qiE "JetBrainsMono.*(NF|Nerd Font)"; then
    echo "Installing JetBrainsMono Nerd Font..."
    mkdir -p ~/.local/share/fonts/jetbrainsmono
    curl -fLo /tmp/JetBrainsMono.tar.xz \
        https://github.com/ryanoasis/nerd-fonts/releases/latest/download/JetBrainsMono.tar.xz
    tar -xf /tmp/JetBrainsMono.tar.xz -C ~/.local/share/fonts/jetbrainsmono
    rm -f /tmp/JetBrainsMono.tar.xz
    fc-cache -f ~/.local/share/fonts >/dev/null
    echo "✓ JetBrainsMono Nerd Font installed"
else
    echo "JetBrainsMono Nerd Font is already installed"
fi
{{- else }}
echo "Skipping font installation (not Linux)"
{{- end }}
